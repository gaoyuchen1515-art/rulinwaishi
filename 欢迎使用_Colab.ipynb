        "!pip install scikit-learn matplotlib seaborn torchsummary -q\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import time\n",
        "import random\n",
        "from tqdm import tqdm\n",
        "from torchsummary import summary\n",
        "\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, random_split\n",
        "from torchvision import datasets, transforms\n",
        "from torchvision.models import swin_t, Swin_T_Weights\n",
        "\n",
        "from sklearn.metrics import accuracy_score, f1_score\n",
        "from sklearn.manifold import TSNE\n",
        "from sklearn.utils import resample\n",
        "\n",
        "seed = 42\n",
        "torch.manual_seed(seed)\n",
        "torch.cuda.manual_seed(seed)\n",
        "np.random.seed(seed)\n",
        "random.seed(seed)\n",
        "torch.backends.cudnn.deterministic = True\n",
        "torch.backends.cudnn.benchmark = False\n",
        "\n",
        "plt.rcParams['figure.figsize'] = (12, 6)\n",
        "plt.rcParams['font.size'] = 12\n",
        "sns.set_style(\"whitegrid\")\n",
        "\n",
        "raw_train_dataset = datasets.CIFAR10(\n",
        "    root='./data', train=True, download=True, transform=transforms.ToTensor()\n",
        ")\n",
        "\n",
        "raw_test_dataset = datasets.CIFAR10(\n",
        "    root='./data', train=False, download=True, transform=transforms.ToTensor()\n",
        ")\n",
        "CIFAR10_classes = ['airplane', 'automobile', 'bird', 'cat', 'deer',\n",
        "                   'dog', 'frog', 'horse', 'ship', 'truck']\n",
        "\n",
        "train_data = torch.stack([img for img, _ in raw_train_dataset])\n",
        "\n",
        "mean = train_data.mean(dim=(0, 2, 3)).numpy()\n",
        "std = train_data.std(dim=(0, 2, 3)).numpy()\n",
        "print(f\"训练集RGB通道均值: {mean.round(4)}\")\n",
        "print(f\"训练集RGB通道标准差: {std.round(4)}\")\n",
        "\n",
        "train_transform = transforms.Compose([\n",
        "    transforms.ToTensor(),\n",
        "    transforms.RandomHorizontalFlip(p=0.5),\n",
        "    transforms.RandomRotation(degrees=10),\n",
        "    transforms.Normalize(mean=mean, std=std)\n",
        "])\n",
        "\n",
        "val_test_transform = transforms.Compose([\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(mean=mean, std=std)\n",
        "])\n",
        "\n",
        "swin_transform = transforms.Compose([\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Resize((224, 224)),\n",
        "    transforms.Normalize(mean=mean, std=std)\n",
        "])\n",
        "\n",
        "full_train_dataset = datasets.CIFAR10(\n",
        "    root='./data', train=True, download=False, transform=train_transform\n",
        ")\n",
        "\n",
        "train_size = 45000\n",
        "val_size = 5000\n",
        "train_dataset, val_dataset = random_split(full_train_dataset, [train_size, val_size])\n",
        "\n",
        "test_dataset = datasets.CIFAR10(\n",
        "    root='./data', train=False, download=False, transform=val_test_transform\n",
        ")\n",
        "\n",
        "swin_train_dataset = datasets.CIFAR10(root='./data', train=True, download=False, transform=swin_transform)\n",
        "swin_train_dataset, swin_val_dataset = random_split(swin_train_dataset, [train_size, val_size])\n",
        "swin_test_dataset = datasets.CIFAR10(root='./data', train=False, download=False, transform=swin_transform)\n",
        "\n",
        "BATCH_SIZE = 16\n",
        "\n",
        "train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=2)\n",
        "val_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n",
        "test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n",
        "\n",
        "swin_train_loader = DataLoader(swin_train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=2)\n",
        "swin_val_loader = DataLoader(swin_val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n",
        "swin_test_loader = DataLoader(swin_test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n",
        "\n",
        "\n",
        "print(f\"\\n数据加载完成：\")\n",
        "print(f\"CNN训练集: {len(train_dataset)} 样本 | 验证集: {len(val_dataset)} 样本 | 测试集: {len(test_dataset)} 样本\")\n",
        "print(f\"Swin-T训练集: {len(swin_train_dataset)} 样本 | 验证集: {len(swin_val_dataset)} 样本 | 测试集: {len(swin_test_dataset)} 样本\")\n",
        "\n",
        "vgg11_config = [\n",
        "    (1, 64, 3, 1, 1), 'M',\n",
        "    (1, 128, 3, 1, 1), 'M',\n",
        "    (2, 256, 3, 1, 1), 'M',\n",
        "    (2, 512, 3, 1, 1), 'M',\n",
        "    (2, 512, 3, 1, 1), 'M'\n",
        "]\n",
        "\n",
        "class VGG11(nn.Module):\n",
        "    def __init__(self, config, num_classes=10):\n",
        "        super(VGG11, self).__init__()\n",
        "        self.features = self._build_features(config)\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Linear(512 * 1 * 1, 512),\n",
        "            nn.ReLU(inplace=True),\n",
        "            nn.Dropout(0.5),\n",
        "            nn.Linear(512, 256),\n",
        "            nn.ReLU(inplace=True),\n",
        "            nn.Dropout(0.5),\n",
        "            nn.Linear(256, num_classes)\n",
        "        )\n",
        "\n",
        "        self._initialize_weights()\n",
        "\n",
        "    def _build_features(self, config):\n",
        "        layers = []\n",
        "        in_channels = 3\n",
        "        for cfg in config:\n",
        "            if cfg == 'M':\n",
        "                layers.append(nn.MaxPool2d(kernel_size=2, stride=2))\n",
        "            else:\n",
        "                conv_layers, out_channels, k, s, p = cfg\n",
        "                for _ in range(conv_layers):\n",
        "                    layers.append(nn.Conv2d(in_channels, out_channels, kernel_size=k, stride=s, padding=p))\n",
        "                    layers.append(nn.BatchNorm2d(out_channels))  # BN加速训练\n",
        "                    layers.append(nn.ReLU(inplace=True))\n",
        "                    in_channels = out_channels\n",
        "        return nn.Sequential(*layers)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.features(x)\n",
        "        x = x.view(x.size(0), -1)\n",
        "        x = self.classifier(x)\n",
        "        return x\n",
        "\n",
        "    def extract_penultimate_feature(self, x):\n",
        "        x = self.features(x)\n",
        "        x = x.view(x.size(0), -1)\n",
        "\n",
        "        for layer in list(self.classifier)[:-1]:\n",
        "            x = layer(x)\n",
        "        return x\n",
        "\n",
        "    def _initialize_weights(self):\n",
        "        for m in self.modules():\n",
        "            if isinstance(m, nn.Conv2d):\n",
        "                nn.init.kaiming_normal_(m.weight, mode='fan_out', nonlinearity='relu')\n",
        "                if m.bias is not None:\n",
        "                    nn.init.constant_(m.bias, 0)\n",
        "            elif isinstance(m, nn.BatchNorm2d):\n",
        "                nn.init.constant_(m.weight, 1)\n",
        "                nn.init.constant_(m.bias, 0)\n",
        "            elif isinstance(m, nn.Linear):\n",
        "                nn.init.normal_(m.weight, 0, 0.01)\n",
        "                nn.init.constant_(m.bias, 0)\n",
        "\n",
        "vgg_model = VGG11(vgg11_config, num_classes=10).to(device)\n",
        "\n",
        "summary(vgg_model, input_size=(3, 32, 32))\n",
        "\n",
        "swin_model = swin_t(weights=Swin_T_Weights.IMAGENET1K_V1).to(device)\n",
        "\n",
        "in_features = swin_model.head.in_features\n",
        "swin_model.head = nn.Linear(in_features=in_features, out_features=10).to(device)\n",
        "\n",
        "def swin_extract_penultimate_feature(model, x):\n",
        "    x = model.features(x)\n",
        "    x = model.norm(x)\n",
        "    x = x.mean(dim=[2, 3])\n",
        "    return x\n",
        "\n",
        "print(\"Swin-T分类头替换完成：\")\n",
        "print(swin_model.head)\n",
        "\n",
        "summary(swin_model, input_size=(3, 224, 224))\n",
        "\n",
        "LEARNING_RATE = 1e-4\n",
        "OPTIMIZER = \"Adam\"\n",
        "EPOCHS = 20\n",
        "LOSS_FUNC = nn.CrossEntropyLoss()\n",
        "\n",
        "print(f\"超参配置（已记录）：\")\n",
        "print(f\"Batch Size: {BATCH_SIZE} | Learning Rate: {LEARNING_RATE}\")\n",
        "print(f\"Optimizer: {OPTIMIZER} | Epochs: {EPOCHS} | Loss Function: CrossEntropyLoss\")\n",
        "\n",
        "\n",
        "def train_model(model, train_loader, val_loader, epochs, lr, optimizer_name, loss_func, device):\n",
        "\n",
        "    if optimizer_name == \"Adam\":\n",
        "        optimizer = optim.Adam(model.parameters(), lr=lr)\n",
        "    elif optimizer_name == \"SGD\":\n",
        "        optimizer = optim.SGD(model.parameters(), lr=lr, momentum=0.9)\n",
        "    else:\n",
        "        raise ValueError(\"优化器仅支持Adam/SGD\")\n",
        "\n",
        "    train_losses = []\n",
        "    val_losses = []\n",
        "\n",
        "    epoch_times = []\n",
        "\n",
        "    model.train()\n",
        "    for epoch in range(epochs):\n",
        "        start_time = time.time()\n",
        "        train_loss = 0.0\n",
        "\n",
        "        for imgs, labels in tqdm(train_loader, desc=f\"Epoch {epoch+1}/{epochs}\"):\n",
        "            imgs, labels = imgs.to(device), labels.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            outputs = model(imgs)\n",
        "            loss = loss_func(outputs, labels)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            train_loss += loss.item() * imgs.size(0)\n",
        "\n",
        "        train_loss /= len(train_loader.dataset)\n",
        "        train_losses.append(train_loss)\n",
        "\n",
        "        model.eval()\n",
        "        val_loss = 0.0\n",
        "        with torch.no_grad():\n",
        "            for imgs, labels in val_loader:\n",
        "                imgs, labels = imgs.to(device), labels.to(device)\n",
        "                outputs = model(imgs)\n",
        "                loss = loss_func(outputs, labels)\n",
        "                val_loss += loss.item() * imgs.size(0)\n",
        "        val_loss /= len(val_loader.dataset)\n",
        "        val_losses.append(val_loss)\n",
        "\n",
        "\n",
        "        epoch_time = time.time() - start_time\n",
        "        epoch_times.append(epoch_time)\n",
        "\n",
        "\n",
        "        print(f\"Epoch {epoch+1} | 训练损失: {train_loss:.4f} | 验证损失: {val_loss:.4f} | 耗时: {epoch_time:.2f}s\")\n",
        "        model.train()\n",
        "\n",
        "    avg_epoch_time = np.mean(epoch_times)\n",
        "    print(f\"\\n训练完成！平均每轮训练时间: {avg_epoch_time:.2f}s\")\n",
        "    return model, train_losses, val_losses, avg_epoch_time\n",
        "\n",
        "def evaluate_model(model, test_loader, device, is_swin=False):\n",
        "    model.eval()\n",
        "    all_preds = []\n",
        "    all_labels = []\n",
        "    with torch.no_grad():\n",
        "        for imgs, labels in tqdm(test_loader, desc=\"评估测试集\"):\n",
        "            imgs, labels = imgs.to(device), labels.to(device)\n",
        "            outputs = model(imgs)\n",
        "            preds = torch.argmax(outputs, dim=1)\n",
        "            all_preds.extend(preds.cpu().numpy())\n",
        "            all_labels.extend(labels.cpu().numpy())\n",
        "\n",
        "    accuracy = accuracy_score(all_labels, all_preds) * 100\n",
        "    f1 = f1_score(all_labels, all_preds, average='macro') * 100\n",
        "    print(f\"测试集准确率: {accuracy:.2f}% | 宏平均F1: {f1:.2f}%\")\n",
        "    return accuracy, f1, all_labels, all_preds\n",
        "\n",
        "def extract_features(model, test_loader, device, is_swin=False, sample_size=1000):\n",
        "    model.eval()\n",
        "    all_features = []\n",
        "    all_labels = []\n",
        "    with torch.no_grad():\n",
        "        for imgs, labels in tqdm(test_loader, desc=\"提取特征\"):\n",
        "            imgs, labels = imgs.to(device), labels.to(device)\n",
        "            if is_swin:\n",
        "\n",
        "                features = swin_extract_penultimate_feature(model, imgs)\n",
        "            else:\n",
        "\n",
        "                features = model.extract_penultimate_feature(imgs)\n",
        "            all_features.extend(features.cpu().numpy())\n",
        "            all_labels.extend(labels.cpu().numpy())\n",
        "\n",
        "    features_np = np.array(all_features)\n",
        "    labels_np = np.array(all_labels)\n",
        "    features_sampled, labels_sampled = resample(features_np, labels_np, n_samples=sample_size, random_state=seed)\n",
        "    print(f\"特征提取完成！采样{sample_size}个样本，特征维度: {features_sampled.shape[1]}\")\n",
        "    return features_sampled, labels_sampled\n",
        "\n",
        "def tsne_visualization(features, labels, title, save_path):\n",
        "\n",
        "    tsne = TSNE(n_components=2, random_state=seed, perplexity=30, n_iter=1000)\n",
        "    features_2d = tsne.fit_transform(features)\n",
        "\n",
        "    plt.figure(figsize=(10, 8))\n",
        "    for c in range(10):\n",
        "        mask = labels == c\n",
        "        plt.scatter(features_2d[mask, 0], features_2d[mask, 1], label=CIFAR10_classes[c], s=10, alpha=0.8)\n",
        "    plt.title(title, fontsize=14)\n",
        "    plt.xlabel(\"t-SNE Dimension 1\")\n",
        "    plt.ylabel(\"t-SNE Dimension 2\")\n",
        "    plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(save_path, dpi=300)\n",
        "    plt.show()\n",
        "    return features_2d\n",
        "\n",
        "def plot_loss_curve(train_losses, val_losses, title, save_path):\n",
        "    plt.figure(figsize=(10, 6))\n",
        "    plt.plot(range(1, EPOCHS+1), train_losses, label=\"训练损失\", linewidth=2)\n",
        "    plt.plot(range(1, EPOCHS+1), val_losses, label=\"验证损失\", linewidth=2)\n",
        "    plt.title(title, fontsize=14)\n",
        "    plt.xlabel(\"Epoch\")\n",
        "    plt.ylabel(\"Loss\")\n",
        "    plt.legend()\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.savefig(save_path, dpi=300)\n",
        "    plt.show()\n",
        "\n",
        "print(\"=\"*50 + \" 开始训练VGG11 \" + \"=\"*50)\n",
        "vgg_trained, vgg_train_losses, vgg_val_losses, vgg_avg_epoch_time = train_model(\n",
        "    model=vgg_model,\n",
        "    train_loader=train_loader,\n",
        "    val_loader=val_loader,\n",
        "    epochs=EPOCHS,\n",
        "    lr=LEARNING_RATE,\n",
        "    optimizer_name=OPTIMIZER,\n",
        "    loss_func=LOSS_FUNC,\n",
        "    device=device\n",
        ")\n",
        "\n",
        "vgg_accuracy, vgg_f1, vgg_test_labels, vgg_test_preds = evaluate_model(\n",
        "    model=vgg_trained,\n",
        "    test_loader=test_loader,\n",
        "    device=device,\n",
        "    is_swin=False\n",
        ")\n",
        "\n",
        "plot_loss_curve(\n",
        "    train_losses=vgg_train_losses,\n",
        "    val_losses=vgg_val_losses,\n",
        "    title=\"VGG11 训练损失 vs 验证损失\",\n",
        "    save_path=\"vgg_loss_curve.png\"\n",
        ")\n",
        "\n",
        "vgg_features, vgg_tsne_labels = extract_features(\n",
        "    model=vgg_trained,\n",
        "    test_loader=test_loader,\n",
        "    device=device,\n",
        "    is_swin=False,\n",
        "    sample_size=1000\n",
        ")\n",
        "tsne_visualization(\n",
        "    features=vgg_features,\n",
        "    labels=vgg_tsne_labels,\n",
        "    title=\"VGG11 倒数第二层特征 t-SNE可视化（CIFAR-10，1000样本）\",\n",
        "    save_path=\"vgg_tsne.png\"\n",
        ")\n",
        "\n",
        "print(\"=\"*50 + \" 开始训练Swin-T \" + \"=\"*50)\n",
        "swin_trained, swin_train_losses, swin_val_losses, swin_avg_epoch_time = train_model(\n",
        "    model=swin_model,\n",
        "    train_loader=swin_train_loader,\n",
        "    val_loader=swin_val_loader,\n",
        "    epochs=EPOCHS,\n",
        "    lr=LEARNING_RATE,\n",
        "    optimizer_name=OPTIMIZER,\n",
        "    loss_func=LOSS_FUNC,\n",
        "    device=device\n",
        ")\n",
        "\n",
        "swin_accuracy, swin_f1, swin_test_labels, swin_test_preds = evaluate_model(\n",
        "    model=swin_trained,\n",
        "    test_loader=swin_test_loader,\n",
        "    device=device,\n",
        "    is_swin=True\n",
        ")\n",
        "\n",
        "plot_loss_curve(\n",
        "    train_losses=swin_train_losses,\n",
        "    val_losses=swin_val_losses,\n",
        "    title=\"Swin-T 训练损失 vs 验证损失\",\n",
        "    save_path=\"swin_loss_curve.png\"\n",
        ")\n",
        "\n",
        "swin_features, swin_tsne_labels = extract_features(\n",
        "    model=swin_trained,\n",
        "    test_loader=swin_test_loader,\n",
        "    device=device,\n",
        "    is_swin=True,\n",
        "    sample_size=1000\n",
        ")\n",
        "tsne_visualization(\n",
        "    features=swin_features,\n",
        "    labels=swin_tsne_labels,\n",
        "    title=\"Swin-T 倒数第二层特征 t-SNE可视化（CIFAR-10，1000样本）\",\n",
        "    save_path=\"swin_tsne.png\"\n",
        ")\n",
        "\n",
        "def count_parameters(model):\n",
        "\n",
        "    return sum(p.numel() for p in model.parameters() if p.requires_grad) / 1e6\n",
        "\n",
        "vgg_params = count_parameters(vgg_trained)\n",
        "swin_params = count_parameters(swin_trained)\n",
        "\n",
        "print(\"=\"*80)\n",
        "print(\"CNN(VGG11) vs Swin-T 最终性能+效率对比（报告核心数据）\")\n",
        "print(\"=\"*80)\n",
        "print(f\"1. 性能指标（测试集）：\")\n",
        "print(f\"   VGG11: 准确率 = {vgg_accuracy:.2f}% | 宏平均F1 = {vgg_f1:.2f}%\")\n",
        "print(f\"   Swin-T: 准确率 = {swin_accuracy:.2f}% | 宏平均F1 = {swin_f1:.2f}%\")\n",
        "print(f\"2. 效率指标：\")\n",
        "print(f\"   VGG11: 可训练参数量 = {vgg_params:.2f}M | 平均每轮训练时间 = {vgg_avg_epoch_time:.2f}s\")\n",
        "print(f\"   Swin-T: 可训练参数量 = {swin_params:.2f}M | 平均每轮训练时间 = {swin_avg_epoch_time:.2f}s\")\n",
        "print(\"=\"*80)\n",
        "\n",
        "comparison_data = {\n",
        "    \"model\": [\"VGG11\", \"Swin-T\"],\n",
        "    \"accuracy(%)\": [vgg_accuracy, swin_accuracy],\n",
        "    \"f1_macro(%)\": [vgg_f1, swin_f1],\n",
        "    \"params(M)\": [vgg_params, swin_params],\n",
        "    \"avg_epoch_time(s)\": [vgg_avg_epoch_time, swin_avg_epoch_time]\n",
        "}\n",
        "import pandas as pd\n",
        "df = pd.DataFrame(comparison_data)\n",
        "df.to_csv(\"model_comparison.csv\", index=False)\n",
        "print(\"对比数据已保存为model_comparison.csv，可直接导入报告！\")\n",
        "\n",
        "from google.colab import files\n",
        "files.download(\"vgg_loss_curve.png\")\n",
        "files.download(\"swin_loss_curve.png\")\n",
        "files.download(\"vgg_tsne.png\")\n",
        "files.download(\"swin_tsne.png\")\n",
        "files.download(\"model_comparison.csv\")"
